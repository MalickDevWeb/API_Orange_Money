{
    "openapi": "3.0.0",
    "info": {
        "title": "API Orange Money",
        "description": "API pour le système de mobile money Orange Money",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api",
            "description": "Serveur de développement"
        }
    ],
    "paths": {},
    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "example": "uuid-user"
                    },
                    "nom": {
                        "type": "string",
                        "example": "Dupont"
                    },
                    "prenom": {
                        "type": "string",
                        "example": "Jean"
                    },
                    "telephone": {
                        "type": "string",
                        "example": "770000001"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "jean.dupont@example.com"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "client",
                            "commercant"
                        ],
                        "example": "client"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Compte": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "example": "uuid-compte"
                    },
                    "numero_compte": {
                        "type": "string",
                        "example": "CMPT-001"
                    },
                    "titulaire": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "code_marchand": {
                        "type": "string",
                        "example": "MRC001",
                        "nullable": true
                    },
                    "statut": {
                        "type": "string",
                        "enum": [
                            "actif",
                            "inactif",
                            "suspendu"
                        ],
                        "example": "actif"
                    },
                    "utilisateur_id": {
                        "type": "string",
                        "format": "uuid",
                        "example": "uuid-user"
                    },
                    "solde": {
                        "type": "number",
                        "format": "float",
                        "example": 15000.5
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Transaction": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "example": "uuid-transaction"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "depot",
                            "retrait",
                            "transfert",
                            "paiement"
                        ],
                        "example": "transfert"
                    },
                    "montant": {
                        "type": "number",
                        "format": "float",
                        "example": 50000
                    },
                    "reference": {
                        "type": "string",
                        "example": "TXN-123456"
                    },
                    "statut": {
                        "type": "string",
                        "enum": [
                            "reussie",
                            "echouee",
                            "annulee"
                        ],
                        "example": "reussie"
                    },
                    "note": {
                        "type": "string",
                        "example": "Paiement de facture",
                        "nullable": true
                    },
                    "compte_emetteur_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "compte_recepteur_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "date_transaction": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            },
            "sanctum": {
                "type": "apiKey",
                "description": "Enter token in format (Bearer <token>)",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "tags": []
}